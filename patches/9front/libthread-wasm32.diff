+	$MACHOFILES\
 	channel.$O\
 	chanprint.$O\
 	create.$O\
@@ -23,11 +27,9 @@
 	ioflush.$O\
 	kill.$O\
 	lib.$O\
-	main.$O\
 	note.$O\
 	ref.$O\
 	rendez.$O\
-	sched.$O\
 
 CFILES=\
 	386.c\
@@ -70,6 +72,13 @@
 spim.$O:	mips.c
 	$CC $CFLAGS -o $target mips.c
 
+wasm32.$O:	wasm32/wasm32.c
+	$CC $CFLAGS -I. -o $target wasm32/wasm32.c
+wasm32main.$O:	wasm32/main.c
+	$CC $CFLAGS -I. -o $target wasm32/main.c
+wasm32sched.$O:	wasm32/sched.c

#!/usr/bin/env python3
# The live image's page on localhost (build/live, or DIR): as a server must
# send it - cross-origin isolated (COOP, COEP: the machine's memory is a
# SharedArrayBuffer its workers share), FILE.gz to a browser that takes
# gzip, no caching (a new build is the page at once).  Offline, and the
# tests' page server.
#   tools/serve [-d DIR] [PORT]	default 18300, on 127.0.0.1
import http.server, os, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
args = sys.argv[1:]
d = os.path.join(root, 'build/live')
if args[:1] == ['-d']:
	d, args = args[1], args[2:]
port = int(args[0]) if args else 18300
TYPES = {'.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.wasm': 'application/wasm'}

class H(http.server.SimpleHTTPRequestHandler):
	def __init__(self, *a, **k):
		super().__init__(*a, directory=d, **k)
	def end_headers(self):
		self.send_header('Cross-Origin-Opener-Policy', 'same-origin')
		self.send_header('Cross-Origin-Embedder-Policy', 'require-corp')
		self.send_header('Cache-Control', 'no-store')
		super().end_headers()
	def do_GET(self):
		p = self.path.split('?')[0]
		if p.endswith('/'):
			p += 'index.html'
		f = os.path.join(d, p.lstrip('/'))
		if os.path.isfile(f) and 'gzip' in self.headers.get('Accept-Encoding', '') and os.path.isfile(f + '.gz'):
			b = open(f + '.gz', 'rb').read()
			self.send_response(200)
			self.send_header('Content-Type', TYPES.get(os.path.splitext(p)[1], 'application/octet-stream'))
			self.send_header('Content-Encoding', 'gzip')
			self.send_header('Content-Length', str(len(b)))
			self.end_headers()
			self.wfile.write(b)
			return
		super().do_GET()
	def log_message(self, *a):
		pass
H.extensions_map.update(TYPES)
http.server.ThreadingHTTPServer(('127.0.0.1', port), H).serve_forever()

#!/usr/bin/env python3
# The live image's page on localhost (build/live, or DIR): as a server must
# send it - cross-origin isolated (COOP, COEP: the machine's memory is a
# SharedArrayBuffer its workers share), FILE.gz to a browser that takes
# gzip, no caching (a new build is the page at once).  And on PORT+1 a
# relay to the machine's network gateway (127.0.0.1:GATEWAY, a webterm:
# the page's WebSockets go to the next port on loopback, kernel.html).
# $PLAN9INI, if set, is the page's plan9.ini (GET /plan9.ini; else DIR's,
# if it has one).  Offline, and the tests' page server.
#   tools/serve [-d DIR] [-g GATEWAY] [PORT]	default 18300, 17080
import asyncio, http.server, os, sys, threading
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
args = sys.argv[1:]
d = os.path.join(root, 'build/live')
gateway = 17080
while args[:1] in (['-d'], ['-g']):
	if args[0] == '-d':
		d = args[1]
	else:
		gateway = int(args[1])
	args = args[2:]
port = int(args[0]) if args else 18300
TYPES = {'.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.wasm': 'application/wasm'}

class H(http.server.SimpleHTTPRequestHandler):
	def __init__(self, *a, **k):
		super().__init__(*a, directory=d, **k)
	def end_headers(self):
		self.send_header('Cross-Origin-Opener-Policy', 'same-origin')
		self.send_header('Cross-Origin-Embedder-Policy', 'require-corp')
		self.send_header('Cache-Control', 'no-store')
		super().end_headers()
	def body(self, b, typ, gz=False):
		self.send_response(200)
		self.send_header('Content-Type', typ)
		if gz:
			self.send_header('Content-Encoding', 'gzip')
		self.send_header('Content-Length', str(len(b)))
		self.end_headers()
		self.wfile.write(b)
	def do_GET(self):
		p = self.path.split('?')[0]
		if p.endswith('/'):
			p += 'index.html'
		if p == '/plan9.ini' and os.environ.get('PLAN9INI') is not None:
			return self.body((os.environ['PLAN9INI'] + '\n').encode(), 'text/plain')
		f = os.path.join(d, p.lstrip('/'))
		if os.path.isfile(f) and 'gzip' in self.headers.get('Accept-Encoding', '') and os.path.isfile(f + '.gz'):
			return self.body(open(f + '.gz', 'rb').read(), TYPES.get(os.path.splitext(p)[1], 'application/octet-stream'), True)
		super().do_GET()
	def log_message(self, *a):
		pass
H.extensions_map.update(TYPES)

async def pipe(r, w):
	try:
		while (b := await r.read(65536)):
			w.write(b)
			await w.drain()
	finally:
		w.close()

async def relay(cr, cw):
	try:
		gr, gw = await asyncio.open_connection('127.0.0.1', gateway)
	except OSError:
		cw.close()
		return
	await asyncio.gather(pipe(cr, gw), pipe(gr, cw), return_exceptions=True)

async def relays():
	srv = await asyncio.start_server(relay, '127.0.0.1', port + 1)
	await srv.serve_forever()

threading.Thread(target=lambda: asyncio.run(relays()), daemon=True).start()
http.server.ThreadingHTTPServer(('127.0.0.1', port), H).serve_forever()

#!/usr/bin/env python3
# The boot file system's archive (#R, devrootfs.c): the files the proto
# names (sys/src/9/wasm32/bootfs.proto, disk/mkfs's form: a line's
# indentation its depth; name, mode, owner, group, source - a source names
# the file from the tree's root, and a directory's names its files' too;
# + all below; a mode d... an empty directory), each its path, a 0, its
# length in four bytes, little-endian, and its bytes; a directory's path
# ends in / (no bytes).
#   tools/bootfs [TREE [PROTO [OUT]]]	default build/tree, its proto, build/root.fs
import os, struct, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
tree = sys.argv[1] if len(sys.argv) > 1 else os.path.join(root, 'build/tree')
proto = sys.argv[2] if len(sys.argv) > 2 else os.path.join(tree, 'sys/src/9/wasm32/bootfs.proto')
out = sys.argv[3] if len(sys.argv) > 3 else os.path.join(root, 'build/root.fs')
ents = []	# (path, source or None for a directory)
stack = []	# (depth, path, source)
missing = []
for ln, line in enumerate(open(proto), 1):
	if not line.strip() or line.lstrip().startswith('#'):
		continue
	depth = len(line) - len(line.lstrip('\t'))
	f = line.split()
	while stack and stack[-1][0] >= depth:
		stack.pop()
	ppath, psrc = (stack[-1][1], stack[-1][2]) if stack else ('', '')
	name = f[0]
	mode = f[1] if len(f) > 1 else '-'
	if name == '+':
		for dp, dn, fn in os.walk(tree + psrc):
			dn.sort()
			for n in sorted(fn):
				s = os.path.relpath(os.path.join(dp, n), tree)
				ents.append((ppath + '/' + os.path.relpath(os.path.join(dp, n), tree + psrc), '/' + s))
		continue
	path = (ppath + '/' + name).lstrip('/')
	src = f[4] if len(f) > 4 else psrc + '/' + name
	stack.append((depth, path, src))
	if mode.startswith('d'):
		ents.append((path, None))
	elif os.path.isfile(tree + src):
		ents.append((path, src))
	elif not os.path.isdir(tree + src):
		missing.append((path, ln, src))	# a directory only its files name
for path, ln, src in missing:
	if not any(p.startswith(path + '/') for p, _ in ents):
		sys.exit('bootfs: %s:%d: no %s' % (proto, ln, src))
# a directory with files needs no entry of its own
dirs = {os.path.dirname(p) + '/' for p, s in ents if s is not None}
with open(out + '.part', 'wb') as o:
	n = 0
	for p, s in ents:
		p = p.lstrip('/')
		if s is None:
			if any(d.startswith(p + '/') for d in dirs):
				continue
			b, p = b'', p + '/'
		else:
			b = open(tree + s, 'rb').read()
		o.write(p.encode() + b'\0' + struct.pack('<I', len(b)) + b)
		n += 1
os.rename(out + '.part', out)
print('bootfs: %s (%d files, %d bytes)' % (out, n, os.path.getsize(out)))
